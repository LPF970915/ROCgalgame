+    void CapturePresentationTexture(const char *requestPath) {
+        static unsigned int capturePoll = 0;
+        if(!requestPath || !requestPath[0] || (++capturePoll % 15) != 0)
+            return;
+
+        std::ifstream request(requestPath);
+        std::string outputPath;
+        std::getline(request, outputPath);
+        request.close();
+        if(outputPath.empty())
+            return;
+        std::remove(requestPath);
+
+        const GLenum pendingError = glGetError();
+        TVPSetRenderTarget(texture);
+        const GLenum framebufferStatus =
+            glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        if(framebufferStatus != GL_FRAMEBUFFER_COMPLETE || pendingError != GL_NO_ERROR) {
+            char captureError[384];
+            snprintf(captureError, sizeof(captureError),
+                     "[rocgalgame] presentation_capture rejected path=%s "
+                     "fbo=0x%04X pending=0x%04X",
+                     outputPath.c_str(), framebufferStatus, pendingError);
+            TVPConsoleLog(captureError);
+            return;
+        }
+
+        std::vector<unsigned char> rgba(
+            static_cast<size_t>(internalW) * internalH * 4);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, internalW, internalH, GL_RGBA, GL_UNSIGNED_BYTE,
+                     rgba.data());
+        const GLenum readError = glGetError();
+        if(readError != GL_NO_ERROR) {
+            char captureError[384];
+            snprintf(captureError, sizeof(captureError),
+                     "[rocgalgame] presentation_capture read failed path=%s "
+                     "error=0x%04X",
+                     outputPath.c_str(), readError);
+            TVPConsoleLog(captureError);
+            return;
+        }
+
+        const std::string temporaryPath = outputPath + ".tmp";
+        std::ofstream output(temporaryPath, std::ios::binary | std::ios::trunc);
+        output << "P6\n" << internalW << " " << internalH << "\n255\n";
+        std::vector<unsigned char> row(static_cast<size_t>(internalW) * 3);
+        for(int y = static_cast<int>(internalH) - 1; y >= 0; --y) {
+            const unsigned char *source =
+                rgba.data() + static_cast<size_t>(y) * internalW * 4;
+            for(unsigned int x = 0; x < internalW; ++x) {
+                row[x * 3] = source[x * 4];
+                row[x * 3 + 1] = source[x * 4 + 1];
+                row[x * 3 + 2] = source[x * 4 + 2];
+            }
+            output.write(reinterpret_cast<const char *>(row.data()),
+                         static_cast<std::streamsize>(row.size()));
+        }
+        output.close();
+        if(!output || std::rename(temporaryPath.c_str(), outputPath.c_str()) != 0) {
+            std::remove(temporaryPath.c_str());
+            TVPConsoleLog("[rocgalgame] presentation_capture file write failed");
+            return;
+        }
+
+        char captureInfo[384];
+        snprintf(captureInfo, sizeof(captureInfo),
+                 "[rocgalgame] presentation_capture path=%s size=%ux%u",
+                 outputPath.c_str(), internalW, internalH);
+        TVPConsoleLog(captureInfo);
+    }
