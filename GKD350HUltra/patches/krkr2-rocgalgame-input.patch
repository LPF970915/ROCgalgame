+    TVPPostInputEvent(
+        new tTVPOnClickInputEvent(tjsNativeInstance, _LastMouseX, _LastMouseY));
+    TVPPostInputEvent(
+        new tTVPOnMouseUpInputEvent(tjsNativeInstance, _LastMouseX, _LastMouseY,
+                                    _mouseBtn, TVPGetCurrentShiftKeyState()));
+}
