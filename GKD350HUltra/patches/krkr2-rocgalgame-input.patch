+void TVPMainScene::moveVirtualMouse(float dx, float dy) {
+    TVPWindowLayer *window = TVPWindowLayer::_currentWindowLayer;
+    if(!_virtualMouseEnabled || !window || !window->PrimaryLayerArea ||
+       !TVPWindowLayer::_mouseCursor || TVPWindowLayer::_windowMgrOverlay)
+        return;
+
+    Vec2 point = TVPWindowLayer::_mouseCursor->getPosition();
+    const Size size = GameNode->getContentSize();
+    point.x = std::max(0.0f, std::min(size.width, point.x + dx));
+    point.y = std::max(0.0f, std::min(size.height, point.y + dy));
+    TVPWindowLayer::_mouseCursor->setPosition(point);
+    window->onMouseMove(GameNode->convertToWorldSpace(point));
+}
+
+void TVPMainScene::postVirtualMouseButton(bool left, bool down) {
+    TVPWindowLayer *window = TVPWindowLayer::_currentWindowLayer;
+    if(!_virtualMouseEnabled || !window || !TVPWindowLayer::_mouseCursor ||
+       TVPWindowLayer::_windowMgrOverlay)
+        return;
+    const Vec2 point = GameNode->convertToWorldSpace(
+        TVPWindowLayer::_mouseCursor->getPosition());
+    window->onVirtualMouseButton(point, left ? mbLeft : mbRight, down);
+}
+
+bool TVPMainScene::handleVirtualMouseButton(int code, bool down) {
+    if(!_rocgalgameInput)
+        return false;
+    if(code == cocos2d::Controller::BUTTON_START) {
+        _padStartDown = down;
+        return false;
+    }
+    if(code == cocos2d::Controller::BUTTON_SELECT) {
+        _padSelectDown = down;
+        return false;
+    }
+    if(!_virtualMouseEnabled)
+        return false;
+
+    if(down) {
+        const float step = std::max(1.0f, _virtualMouseSpeed / 15.0f);
+        switch(code) {
+            case cocos2d::Controller::BUTTON_DPAD_UP:
+                moveVirtualMouse(0, step); return true;
+            case cocos2d::Controller::BUTTON_DPAD_DOWN:
+                moveVirtualMouse(0, -step); return true;
+            case cocos2d::Controller::BUTTON_DPAD_LEFT:
+                moveVirtualMouse(-step, 0); return true;
+            case cocos2d::Controller::BUTTON_DPAD_RIGHT:
+                moveVirtualMouse(step, 0); return true;
+            default:
+                break;
+        }
+    } else if(code == cocos2d::Controller::BUTTON_DPAD_UP ||
+              code == cocos2d::Controller::BUTTON_DPAD_DOWN ||
+              code == cocos2d::Controller::BUTTON_DPAD_LEFT ||
+              code == cocos2d::Controller::BUTTON_DPAD_RIGHT) {
+        return true;
+    }
+
+    const int leftButton = _swapFaceButtons ?
+        cocos2d::Controller::BUTTON_B : cocos2d::Controller::BUTTON_A;
+    const int rightButton = _swapFaceButtons ?
+        cocos2d::Controller::BUTTON_A : cocos2d::Controller::BUTTON_B;
+    if(code == leftButton || code == rightButton) {
+        postVirtualMouseButton(code == leftButton, down);
+        return true;
+    }
+    return false;
+}
