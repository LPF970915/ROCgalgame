+static bool TVPReadEnvironmentFlag(const char *name, bool fallback) {
+    const char *value = std::getenv(name);
+    if(!value)
+        return fallback;
+    return std::strcmp(value, "0") != 0;
+}
+
+static float TVPReadPositiveEnvironmentFloat(const char *name, float fallback) {
+    const char *value = std::getenv(name);
+    if(!value)
+        return fallback;
+    char *end = nullptr;
+    const float parsed = std::strtof(value, &end);
+    if(end == value || !std::isfinite(parsed) || parsed <= 0.0f)
+        return fallback;
+    return parsed;
+}
