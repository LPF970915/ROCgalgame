@@ -1524,7 +1524,18 @@ void TVPConsoleLog(const ttstr &l, bool important) {
     if(TVPWindowLayer::TVPWindowLayer::_consoleWin) {
         TVPWindowLayer::TVPWindowLayer::_consoleWin->addLine(
             l, important ? Color3B::YELLOW : Color3B::GRAY);
-        TVPDrawSceneOnce(100); // force update in 10fps
+        static tjs_uint64 lastConsoleDrawTick = 0;
+        const tjs_uint64 now = TVPGetTickCount();
+        const bool rocgalgameRuntime =
+            std::getenv("ROCGALGAME_KRKR_RUNTIME") != nullptr;
+        if(!rocgalgameRuntime || important || lastConsoleDrawTick == 0 ||
+           now - lastConsoleDrawTick >= 1000) {
+            // Software rendering can make this forced startup-console redraw
+            // much slower than its nominal 100 ms delay. Keep ordinary logs
+            // flowing while limiting ROCgalgame's console to one redraw/sec.
+            TVPDrawSceneOnce(100);
+            lastConsoleDrawTick = TVPGetTickCount();
+        }
     }
     spdlog::get("tjs2")->info("{}", l.AsStdString());
 }
