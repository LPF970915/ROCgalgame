+static bool TVPUsesGKDController(const cocos2d::Controller *controller) {
+    if(!controller || !std::getenv("ROCGALGAME_KRKR_RUNTIME"))
+        return false;
+    const char *profile = std::getenv("ROCGALGAME_INPUT_PROFILE");
+    return profile && std::strcmp(profile, "gkd350h-ultra") == 0 &&
+        controller->getDeviceName() == "gkd_atom_joypad";
+}
+
+static int TVPNormalizeGKDButton(cocos2d::Controller *controller, int code) {
+    if(!TVPUsesGKDController(controller) || code >= 1000)
+        return code;
+    switch(code) {
+        case 0: return cocos2d::Controller::BUTTON_A;
+        case 1: return cocos2d::Controller::BUTTON_B;
+        case 2: return cocos2d::Controller::BUTTON_X;
+        case 3: return cocos2d::Controller::BUTTON_Y;
+        case 4: return cocos2d::Controller::BUTTON_LEFT_SHOULDER;
+        case 5: return cocos2d::Controller::BUTTON_RIGHT_SHOULDER;
+        case 6: return cocos2d::Controller::AXIS_LEFT_TRIGGER;
+        case 7: return cocos2d::Controller::AXIS_RIGHT_TRIGGER;
+        case 9: return cocos2d::Controller::BUTTON_START;
+        case 10: return cocos2d::Controller::BUTTON_SELECT;
+        case 12: return cocos2d::Controller::BUTTON_DPAD_UP;
+        case 13: return cocos2d::Controller::BUTTON_DPAD_DOWN;
+        case 14: return cocos2d::Controller::BUTTON_DPAD_LEFT;
+        case 15: return cocos2d::Controller::BUTTON_DPAD_RIGHT;
+        default: return code;
+    }
+}
+
+static int TVPNormalizeGKDAxis(cocos2d::Controller *controller, int code) {
+    if(!TVPUsesGKDController(controller) || code >= 1000)
+        return code;
+    switch(code) {
+        case 0: return cocos2d::Controller::JOYSTICK_LEFT_X;
+        case 1: return cocos2d::Controller::JOYSTICK_LEFT_Y;
+        default: return code;
+    }
+}
