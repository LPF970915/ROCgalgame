+static int TVPReadDisplayDimension(const char *name, int fallback) {
+    const char *value = std::getenv(name);
+    if(!value)
+        return fallback;
+    char *end = nullptr;
+    const long parsed = std::strtol(value, &end, 10);
+    if(end == value || *end != '\0' || parsed < 320 || parsed > 8192 ||
+       parsed > std::numeric_limits<int>::max())
+        return fallback;
+    return static_cast<int>(parsed);
+}
