+void TVPMainScene::postRocgalgameBridgeKey(unsigned int code, bool down) {
+    if(!code || code >= 0x200 || !TVPWindowLayer::_currentWindowLayer)
+        return;
+    code = _keymap[code];
+    if(down) {
+        TVPWindowLayer::_scancode[code] = 0x11;
+        TVPWindowLayer::_currentWindowLayer->InternalKeyDown(
+            code, TVPGetCurrentShiftKeyState());
+        return;
+    }
+    const bool isPressed = TVPWindowLayer::_scancode[code] & 1;
+    TVPWindowLayer::_scancode[code] &= 0x10;
+    if(isPressed) {
+        TVPWindowLayer::_currentWindowLayer->OnKeyUp(
+            code, TVPGetCurrentShiftKeyState());
+    }
+}
