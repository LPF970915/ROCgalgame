+void TVPMainScene::pollRocgalgameInputBridge() {
+#if !defined(_WIN32)
+    if(_rocgalgameInputFd < 0) {
+        const char *path = std::getenv("ROCGALGAME_KRKR_INPUT_FIFO");
+        if(path && *path) {
+            _rocgalgameInputFd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+            if(_rocgalgameInputFd >= 0)
+                CCLOG("[rocgalgame] frontend input bridge ready: %s", path);
+        }
+    }
+    if(_rocgalgameInputFd < 0)
+        return;
+
+    char chunk[512];
+    while(true) {
+        const ssize_t count = read(_rocgalgameInputFd, chunk, sizeof(chunk));
+        if(count > 0) {
+            _rocgalgameInputBuffer.append(chunk, static_cast<size_t>(count));
+            continue;
+        }
+        if(count < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            close(_rocgalgameInputFd);
+            _rocgalgameInputFd = -1;
+        }
+        break;
+    }
+    if(_rocgalgameInputBuffer.size() > 8192)
+        _rocgalgameInputBuffer.clear();
+
+    size_t newline = std::string::npos;
+    while((newline = _rocgalgameInputBuffer.find('\n')) != std::string::npos) {
+        const std::string line = _rocgalgameInputBuffer.substr(0, newline);
+        _rocgalgameInputBuffer.erase(0, newline + 1);
+        std::istringstream input(line);
+        char type = 0;
+        input >> type;
+        if(type == 'M') {
+            int dx = 0;
+            int dy = 0;
+            if(input >> dx >> dy)
+                moveVirtualMouse(static_cast<float>(dx), static_cast<float>(-dy));
+        } else if(type == 'B') {
+            char button = 0;
+            int down = 0;
+            if(input >> button >> down) {
+                postVirtualMouseButton(button == 'L', down != 0);
+                CCLOG("[rocgalgame] frontend input button: %c %d", button, down);
+            }
+        } else if(type == 'K') {
+            unsigned int code = 0;
+            int down = 0;
+            if(input >> code >> down) {
+                postRocgalgameBridgeKey(code, down != 0);
+                CCLOG("[rocgalgame] frontend input key: %u %d", code, down);
+            }
+        }
+    }
+#endif
+}
