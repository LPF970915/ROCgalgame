--- /dev/null
+++ b/cpp/plugins/gfxEffect.cpp
@@ -0,0 +1,188 @@
+#include "ncbind.hpp"
+
+#include <algorithm>
+#include <vector>
+
+#define NCB_MODULE_NAME TJS_W("gfxEffect.dll")
+
+// Native ARM builds cannot load the original Win32 plug-in. Keep the full
+// public gfxFire state contract available so KAG systems can initialize and
+// games that do not require its optional fire renderer can continue.
+class gfxFire {
+public:
+    gfxFire() { resizeSeeds(1); }
+
+    void cycle() {}
+    void updateWarpMap() {}
+    void updateCoolMap() {}
+    void applyBlue() { colorMode_ = ColorModeBlue; }
+    void applyRed() { colorMode_ = ColorModeRed; }
+    void applyWhite() { colorMode_ = ColorModeWhite; }
+    void applyCustom() { colorMode_ = ColorModeCustom; }
+    void setCustomColorTable(tTJSVariant layer) {
+        customColorTable_ = layer;
+    }
+
+    tTJSVariant getSeedLayer() const { return seedLayers_.front(); }
+    void setSeedLayer(tTJSVariant layer) { seedLayers_.front() = layer; }
+    tTJSVariant getTargetLayer() const { return targetLayer_; }
+    void setTargetLayer(tTJSVariant layer) { targetLayer_ = layer; }
+
+    tjs_uint getSeedX() const { return seedX_.front(); }
+    void setSeedX(tjs_uint value) { seedX_.front() = value; }
+    tjs_uint getSeedY() const { return seedY_.front(); }
+    void setSeedY(tjs_uint value) { seedY_.front() = value; }
+    tjs_uint getNumOfSeeds() const {
+        return static_cast<tjs_uint>(seedLayers_.size());
+    }
+
+    tjs_uint getRandomSeed() const { return randomSeed_; }
+    void setRandomSeed(tjs_uint value) { randomSeed_ = value; }
+    tjs_int getForceH() const { return forceH_; }
+    void setForceH(tjs_int value) { forceH_ = clamp(value, -7, 7); }
+    tjs_int getForceV() const { return forceV_; }
+    void setForceV(tjs_int value) { forceV_ = clamp(value, -7, 7); }
+    tjs_uint getBoundRangeH() const { return boundRangeH_; }
+    void setBoundRangeH(tjs_uint value) {
+        boundRangeH_ = clamp(value, static_cast<tjs_uint>(1),
+                             static_cast<tjs_uint>(16));
+    }
+    tjs_uint getBoundRangeV() const { return boundRangeV_; }
+    void setBoundRangeV(tjs_uint value) {
+        boundRangeV_ = clamp(value, static_cast<tjs_uint>(1),
+                             static_cast<tjs_uint>(16));
+    }
+    tjs_real getScalingCoeff() const { return scalingCoeff_; }
+    void setScalingCoeff(tjs_real value) {
+        scalingCoeff_ = clamp(value, static_cast<tjs_real>(0.000001),
+                              static_cast<tjs_real>(0.009999));
+    }
+    tjs_uint getNumOfBlurForCoolMap() const { return blurCount_; }
+    void setNumOfBlurForCoolMap(tjs_uint value) {
+        blurCount_ = std::max<tjs_uint>(1, value);
+    }
+    tjs_int getTextureFilterType() const { return textureFilterType_; }
+    void setTextureFilterType(tjs_int value) {
+        textureFilterType_ = value == 0 ? 0 : 1;
+    }
+    tjs_uint getCoolRange() const { return coolRange_; }
+    void setCoolRange(tjs_uint value) {
+        coolRange_ = clamp(value, static_cast<tjs_uint>(1),
+                           static_cast<tjs_uint>(255));
+    }
+    tjs_uint getCoolStrength() const { return coolStrength_; }
+    void setCoolStrength(tjs_uint value) {
+        coolStrength_ = std::min<tjs_uint>(254, value);
+    }
+    tjs_uint getCoolParticleDensityDenominator() const {
+        return coolDensityDenominator_;
+    }
+    void setCoolParticleDensityDenominator(tjs_uint value) {
+        coolDensityDenominator_ = std::max<tjs_uint>(1, value);
+    }
+    tjs_uint getCoolParticleDensityNumerator() const {
+        return coolDensityNumerator_;
+    }
+    void setCoolParticleDensityNumerator(tjs_uint value) {
+        coolDensityNumerator_ = std::max<tjs_uint>(1, value);
+    }
+    bool getEdgeSmoothing() const { return edgeSmoothing_; }
+    void setEdgeSmoothing(bool value) { edgeSmoothing_ = value; }
+
+    static tjs_error initCompat(tTJSVariant *result, tjs_int numparams,
+                                tTJSVariant **param,
+                                iTJSDispatch2 *objthis) {
+        gfxFire *self = getInstance(objthis);
+        if(!self || numparams < 1 || !param[0] ||
+           param[0]->Type() != tvtObject) {
+            return TJS_E_INVALIDPARAM;
+        }
+        tjs_uint count = 1;
+        if(numparams > 1 && param[1] && param[1]->Type() != tvtVoid) {
+            count = std::max<tjs_uint>(1, param[1]->AsInteger());
+        }
+        self->targetLayer_ = *param[0];
+        self->resizeSeeds(count);
+        clearResult(result);
+        return TJS_S_OK;
+    }
+
+    static tjs_error clearFireSeedCompat(tTJSVariant *result,
+                                         tjs_int numparams,
+                                         tTJSVariant **param,
+                                         iTJSDispatch2 *objthis) {
+        gfxFire *self = getInstance(objthis);
+        if(!self) return TJS_E_INVALIDOBJECT;
+        const tjs_uint index = optionalIndex(numparams, param);
+        if(index >= self->seedLayers_.size()) return TJS_E_INVALIDPARAM;
+        self->seedLayers_[index].Clear();
+        clearResult(result);
+        return TJS_S_OK;
+    }
+
+    static tjs_error setFireSeedCompat(tTJSVariant *result,
+                                       tjs_int numparams,
+                                       tTJSVariant **param,
+                                       iTJSDispatch2 *objthis) {
+        gfxFire *self = getInstance(objthis);
+        if(!self || numparams < 1 || !param[0]) return TJS_E_INVALIDPARAM;
+        const tjs_uint index = optionalIndex(numparams - 1, param + 1);
+        if(index >= self->seedLayers_.size()) return TJS_E_INVALIDPARAM;
+        self->seedLayers_[index] = *param[0];
+        clearResult(result);
+        return TJS_S_OK;
+    }
+
+    static tjs_error setFireSeedPosCompat(tTJSVariant *result,
+                                          tjs_int numparams,
+                                          tTJSVariant **param,
+                                          iTJSDispatch2 *objthis) {
+        gfxFire *self = getInstance(objthis);
+        if(!self || numparams < 2 || !param[0] || !param[1])
+            return TJS_E_INVALIDPARAM;
+        const tjs_uint index = optionalIndex(numparams - 2, param + 2);
+        if(index >= self->seedLayers_.size()) return TJS_E_INVALIDPARAM;
+        self->seedX_[index] = param[0]->AsInteger();
+        self->seedY_[index] = param[1]->AsInteger();
+        clearResult(result);
+        return TJS_S_OK;
+    }
+
+private:
+    enum ColorMode { ColorModeBlue, ColorModeRed, ColorModeWhite,
+                     ColorModeCustom };
+
+    template <typename T>
+    static T clamp(T value, T low, T high) {
+        return std::max(low, std::min(value, high));
+    }
+    static void clearResult(tTJSVariant *result) {
+        if(result) result->Clear();
+    }
+    static gfxFire *getInstance(iTJSDispatch2 *objthis) {
+        return objthis
+            ? ncbInstanceAdaptor<gfxFire>::GetNativeInstance(objthis, true)
+            : nullptr;
+    }
+    static tjs_uint optionalIndex(tjs_int numparams, tTJSVariant **param) {
+        return numparams > 0 && param[0] && param[0]->Type() != tvtVoid
+            ? std::max<tjs_int64>(0, param[0]->AsInteger()) : 0;
+    }
+    void resizeSeeds(tjs_uint count) {
+        count = clamp<tjs_uint>(count, 1, 256);
+        seedLayers_.resize(count);
+        seedX_.resize(count, 0);
+        seedY_.resize(count, 0);
+    }
+
+    tTJSVariant targetLayer_;
+    tTJSVariant customColorTable_;
+    std::vector<tTJSVariant> seedLayers_;
+    std::vector<tjs_uint> seedX_;
+    std::vector<tjs_uint> seedY_;
+    ColorMode colorMode_ = ColorModeRed;
+    tjs_uint randomSeed_ = 5489;
+    tjs_int forceH_ = 0;
+    tjs_int forceV_ = -2;
+    tjs_uint boundRangeH_ = 8;
+    tjs_uint boundRangeV_ = 8;
+    tjs_real scalingCoeff_ = 0.004;
+    tjs_uint blurCount_ = 1;
+    tjs_int textureFilterType_ = 1;
+    tjs_uint coolRange_ = 128;
+    tjs_uint coolStrength_ = 64;
+    tjs_uint coolDensityDenominator_ = 1;
+    tjs_uint coolDensityNumerator_ = 1;
+    bool edgeSmoothing_ = false;
+};
+
+NCB_REGISTER_CLASS(gfxFire) {
+    NCB_CONSTRUCTOR(());
+    NCB_METHOD_RAW_CALLBACK(init, &gfxFire::initCompat, 0);
+    NCB_METHOD(cycle);
+    NCB_METHOD(updateWarpMap);
+    NCB_METHOD(updateCoolMap);
+    NCB_METHOD(applyBlue);
+    NCB_METHOD(applyRed);
+    NCB_METHOD(applyWhite);
+    NCB_METHOD(applyCustom);
+    NCB_METHOD(setCustomColorTable);
+    NCB_METHOD_RAW_CALLBACK(clearFireSeed, &gfxFire::clearFireSeedCompat, 0);
+    NCB_METHOD_RAW_CALLBACK(setFireSeed, &gfxFire::setFireSeedCompat, 0);
+    NCB_METHOD_RAW_CALLBACK(setFireSeedPos, &gfxFire::setFireSeedPosCompat, 0);
+    NCB_PROPERTY(seedLayer, getSeedLayer, setSeedLayer);
+    NCB_PROPERTY(targetLayer, getTargetLayer, setTargetLayer);
+    NCB_PROPERTY(seedX, getSeedX, setSeedX);
+    NCB_PROPERTY(seedY, getSeedY, setSeedY);
+    NCB_PROPERTY_RO(numOfSeeds, getNumOfSeeds);
+    NCB_PROPERTY(randomSeed, getRandomSeed, setRandomSeed);
+    NCB_PROPERTY(forceH, getForceH, setForceH);
+    NCB_PROPERTY(forceV, getForceV, setForceV);
+    NCB_PROPERTY(boundRangeH, getBoundRangeH, setBoundRangeH);
+    NCB_PROPERTY(boundRangeV, getBoundRangeV, setBoundRangeV);
+    NCB_PROPERTY(scalingCoeff, getScalingCoeff, setScalingCoeff);
+    NCB_PROPERTY(numOfBlurForCoolMap, getNumOfBlurForCoolMap,
+                 setNumOfBlurForCoolMap);
+    NCB_PROPERTY(textureFilterType, getTextureFilterType,
+                 setTextureFilterType);
+    NCB_PROPERTY(coolRange, getCoolRange, setCoolRange);
+    NCB_PROPERTY(coolStrength, getCoolStrength, setCoolStrength);
+    NCB_PROPERTY(coolParticleDensityDenominator,
+                 getCoolParticleDensityDenominator,
+                 setCoolParticleDensityDenominator);
+    NCB_PROPERTY(coolParticleDensityNumerator,
+                 getCoolParticleDensityNumerator,
+                 setCoolParticleDensityNumerator);
+    NCB_PROPERTY(edgeSmoothing, getEdgeSmoothing, setEdgeSmoothing);
+}
