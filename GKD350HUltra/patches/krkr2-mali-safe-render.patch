+    void ProbePresentationTexture() {
+        if(!TVPGetEnvironmentFlag("ROCGALGAME_KRKR_PRESENTATION_PROBE"))
+            return;
+
+        static unsigned int probeCall = 0;
+        ++probeCall;
+        if(probeCall > 256 || (probeCall & (probeCall - 1)) != 0)
+            return;
+
+        const GLenum pendingError = glGetError();
+        TVPSetRenderTarget(texture);
+        const GLenum framebufferStatus =
+            glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        const int xs[] = { 0, (int)internalW / 4, (int)internalW / 2,
+                           (int)internalW * 3 / 4, (int)internalW - 1 };
+        const int ys[] = { 0, (int)internalH / 4, (int)internalH / 2,
+                           (int)internalH * 3 / 4, (int)internalH - 1 };
+        uint32_t sampleOr = 0;
+        for(unsigned int i = 0; i < sizeof(xs) / sizeof(xs[0]); ++i) {
+            uint32_t pixel = 0;
+            glReadPixels(xs[i], ys[i], 1, 1, GL_RGBA, GL_UNSIGNED_BYTE,
+                         &pixel);
+            sampleOr |= pixel;
+        }
+        const GLenum readError = glGetError();
+        char probeInfo[384];
+        snprintf(probeInfo, sizeof(probeInfo),
+                 "[rocgalgame] presentation_probe call=%u texture=%u "
+                 "size=%ux%u logical=%ux%u fbo=0x%04X pending=0x%04X "
+                 "read=0x%04X sample_or=0x%08X",
+                 probeCall, texture, internalW, internalH, GetWidth(),
+                 GetHeight(), framebufferStatus, pendingError, readError,
+                 sampleOr);
+        TVPConsoleLog(probeInfo);
+    }
