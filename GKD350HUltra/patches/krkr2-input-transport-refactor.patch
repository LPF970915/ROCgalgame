diff --git a/cpp/core/environ/cocos2d/RocgalgameInputTransport.cpp b/cpp/core/environ/cocos2d/RocgalgameInputTransport.cpp
new file mode 100644
index 0000000..d1ccd27
--- /dev/null
+++ b/cpp/core/environ/cocos2d/RocgalgameInputTransport.cpp
@@ -0,0 +1,237 @@
+#include "RocgalgameInputTransport.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <sstream>
+#include <thread>
+
+#if !defined(_WIN32)
+#include <cerrno>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#endif
+
+namespace {
+constexpr std::size_t kDiscreteQueueCapacity = 128;
+constexpr std::uint64_t kAxisTimeoutMs = 400;
+
+std::uint64_t SteadyMilliseconds() {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+}
+
+struct RocgalgameInputTransport::Impl {
+    std::atomic<bool> stopRequested{false};
+    std::thread reader;
+    std::mutex mutex;
+    std::string path;
+    std::string inputBuffer;
+    std::deque<RocgalgameInputEvent> events;
+    std::array<bool, 2> mouseButtons{};
+    std::array<bool, 0x200> keys{};
+    float axisX = 0.0f;
+    float axisY = 0.0f;
+    std::uint64_t axisSequence = 0;
+    std::uint64_t axisTimestampMs = 0;
+    std::uint64_t deliveredAxisSequence = 0;
+    bool connected = false;
+    bool reconcile = false;
+    RocgalgameInputStats stats;
+
+    void pushEvent(const RocgalgameInputEvent &event) {
+        if(reconcile)
+            return;
+        if(events.size() >= kDiscreteQueueCapacity) {
+            events.clear();
+            reconcile = true;
+            ++stats.queueOverflows;
+            return;
+        }
+        events.push_back(event);
+    }
+
+    void parseLine(const std::string &line) {
+        std::istringstream input(line);
+        char type = 0;
+        input >> type;
+        std::lock_guard<std::mutex> lock(mutex);
+        if(type == 'A') {
+            float nextX = 0.0f;
+            float nextY = 0.0f;
+            std::uint64_t sequence = 0;
+            if(!(input >> nextX >> nextY >> sequence) ||
+               !std::isfinite(nextX) || !std::isfinite(nextY))
+                return;
+            ++stats.parsedAxis;
+            if(sequence <= axisSequence) {
+                ++stats.discardedAxis;
+                return;
+            }
+            if(axisSequence > deliveredAxisSequence)
+                ++stats.discardedAxis;
+            axisX = std::max(-1.0f, std::min(nextX, 1.0f));
+            axisY = std::max(-1.0f, std::min(nextY, 1.0f));
+            axisSequence = sequence;
+            axisTimestampMs = SteadyMilliseconds();
+            connected = true;
+            return;
+        }
+        if(type == 'B') {
+            char button = 0;
+            int down = 0;
+            if(!(input >> button >> down) || (button != 'L' && button != 'R'))
+                return;
+            const std::size_t index = button == 'L' ? 0 : 1;
+            mouseButtons[index] = down != 0;
+            ++stats.parsedButtons;
+            pushEvent({RocgalgameInputEventType::MouseButton,
+                       static_cast<unsigned int>(index), down != 0});
+            connected = true;
+            return;
+        }
+        if(type == 'K') {
+            unsigned int code = 0;
+            int down = 0;
+            if(!(input >> code >> down) || code == 0 || code >= keys.size())
+                return;
+            keys[code] = down != 0;
+            ++stats.parsedKeys;
+            pushEvent({RocgalgameInputEventType::Key, code, down != 0});
+            connected = true;
+        }
+    }
+
+    void publishDisconnect() {
+        std::lock_guard<std::mutex> lock(mutex);
+        if(!connected)
+            return;
+        connected = false;
+        axisX = 0.0f;
+        axisY = 0.0f;
+        axisTimestampMs = 0;
+        mouseButtons.fill(false);
+        keys.fill(false);
+        events.clear();
+        reconcile = true;
+    }
+
+    void run() {
+#if !defined(_WIN32)
+        int fd = -1;
+        while(!stopRequested.load(std::memory_order_relaxed)) {
+            if(fd < 0) {
+                fd = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+                if(fd < 0) {
+                    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+                    continue;
+                }
+            }
+
+            pollfd descriptor{fd, POLLIN | POLLHUP | POLLERR, 0};
+            const int ready = poll(&descriptor, 1, 50);
+            if(ready < 0) {
+                if(errno == EINTR)
+                    continue;
+                close(fd);
+                fd = -1;
+                publishDisconnect();
+                continue;
+            }
+            if(ready == 0)
+                continue;
+            if(descriptor.revents & POLLIN) {
+                char chunk[512];
+                while(true) {
+                    const ssize_t count = read(fd, chunk, sizeof(chunk));
+                    if(count > 0) {
+                        {
+                            std::lock_guard<std::mutex> lock(mutex);
+                            stats.bytes += static_cast<std::uint64_t>(count);
+                        }
+                        inputBuffer.append(chunk, static_cast<std::size_t>(count));
+                        continue;
+                    }
+                    if(count < 0 && errno != EAGAIN && errno != EWOULDBLOCK &&
+                       errno != EINTR) {
+                        close(fd);
+                        fd = -1;
+                        publishDisconnect();
+                    }
+                    break;
+                }
+                if(inputBuffer.size() > 8192)
+                    inputBuffer.clear();
+                std::size_t newline = std::string::npos;
+                while((newline = inputBuffer.find('\n')) != std::string::npos) {
+                    const std::string line = inputBuffer.substr(0, newline);
+                    inputBuffer.erase(0, newline + 1);
+                    parseLine(line);
+                }
+            }
+            if(fd >= 0 && (descriptor.revents & (POLLHUP | POLLERR)))
+                publishDisconnect();
+        }
+        if(fd >= 0)
+            close(fd);
+#endif
+        publishDisconnect();
+    }
+};
+
+RocgalgameInputTransport::RocgalgameInputTransport()
+    : _impl(std::make_unique<Impl>()) {}
+
+RocgalgameInputTransport::~RocgalgameInputTransport() {
+    stop();
+}
+
+bool RocgalgameInputTransport::start(const std::string &path) {
+    if(path.empty() || _impl->reader.joinable())
+        return false;
+    _impl->path = path;
+    _impl->stopRequested.store(false, std::memory_order_relaxed);
+    _impl->reader = std::thread([this] { _impl->run(); });
+    return true;
+}
+
+void RocgalgameInputTransport::stop() {
+    _impl->stopRequested.store(true, std::memory_order_relaxed);
+    if(_impl->reader.joinable())
+        _impl->reader.join();
+}
+
+RocgalgameInputSnapshot RocgalgameInputTransport::drain() {
+    RocgalgameInputSnapshot snapshot;
+    const std::uint64_t now = SteadyMilliseconds();
+    std::lock_guard<std::mutex> lock(_impl->mutex);
+    snapshot.axisX = _impl->axisX;
+    snapshot.axisY = _impl->axisY;
+    snapshot.axisSequence = _impl->axisSequence;
+    snapshot.connected = _impl->connected;
+    snapshot.axisFresh = _impl->connected && _impl->axisTimestampMs != 0 &&
+        now - _impl->axisTimestampMs <= kAxisTimeoutMs;
+    snapshot.reconcile = _impl->reconcile;
+    snapshot.mouseButtons = _impl->mouseButtons;
+    snapshot.keys = _impl->keys;
+    snapshot.events.assign(_impl->events.begin(), _impl->events.end());
+    _impl->events.clear();
+    _impl->reconcile = false;
+    _impl->deliveredAxisSequence = _impl->axisSequence;
+    return snapshot;
+}
+
+RocgalgameInputStats RocgalgameInputTransport::takeStats() {
+    std::lock_guard<std::mutex> lock(_impl->mutex);
+    RocgalgameInputStats result = _impl->stats;
+    result.queueDepth = _impl->events.size();
+    _impl->stats = {};
+    return result;
+}
