+namespace {
+    tjs_error getEmoteCameraOffsetCompat(tTJSVariant *result, tjs_int,
+                                         tTJSVariant **,
+                                         iTJSDispatch2 *objthis) {
+        auto *self =
+            ncbInstanceAdaptor<EmotePlayer>::GetNativeInstance(objthis, true);
+        if(!self)
+            return TJS_E_INVALIDOBJECT;
+        if(result)
+            *result = self->getPlayer().getCameraOffset();
+        return TJS_S_OK;
+    }
+
+    tjs_error setEmoteCameraOffsetCompat(tTJSVariant *, tjs_int numparams,
+                                         tTJSVariant **param,
+                                         iTJSDispatch2 *objthis) {
+        auto *self =
+            ncbInstanceAdaptor<EmotePlayer>::GetNativeInstance(objthis, true);
+        if(!self)
+            return TJS_E_INVALIDOBJECT;
+        if(numparams < 2 || !param[0] || !param[1])
+            return TJS_E_INVALIDPARAM;
+
+        iTJSDispatch2 *dictionary = TJSCreateDictionaryObject();
+        if(!dictionary)
+            return TJS_E_FAIL;
+        tTJSVariant offset(dictionary);
+        dictionary->Release();
+
+        tTJSVariant x(param[0]->AsReal());
+        tTJSVariant y(param[1]->AsReal());
+        dictionary->PropSet(TJS_MEMBERENSURE, TJS_W("x"), nullptr, &x,
+                            dictionary);
+        dictionary->PropSet(TJS_MEMBERENSURE, TJS_W("y"), nullptr, &y,
+                            dictionary);
+        self->getPlayer().setCameraOffset(offset);
+        return TJS_S_OK;
+    }
+}
