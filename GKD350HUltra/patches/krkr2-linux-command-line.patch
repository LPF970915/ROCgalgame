+    for(int i = 2; i < argc; ++i) {
+        std::u16string argument =
+            boost::locale::conv::utf_to_utf<char16_t>(argv[i]);
+        const size_t separator = argument.find(u'=');
+        if(separator == std::u16string::npos) {
+            TVPSetCommandLine(argument.c_str(), ttstr(TJS_W("yes")));
