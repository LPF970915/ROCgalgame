+    //---------------------------------------------------------------------------
+    static bool TJSIsRegExpHexDigit(tjs_char ch) {
+        return (ch >= TJS_W('0') && ch <= TJS_W('9')) ||
+            (ch >= TJS_W('a') && ch <= TJS_W('f')) ||
+            (ch >= TJS_W('A') && ch <= TJS_W('F'));
+    }
+
+    //---------------------------------------------------------------------------
+    static ttstr TJSNormalizeLegacyRegExpHexEscapes(const ttstr &expression) {
+        // TJS regular expressions use JavaScript-style \xHH and historically
+        // also accept \xHHHH. Oniguruma treats \x as a raw byte escape, which
+        // is incomplete under its UTF-16 encoding. Convert only active escape
+        // sequences; paired backslashes and \x{...} remain untouched.
+        ttstr normalized;
+        const tjs_int length = expression.GetLen();
+        tjs_int offset = 0;
+        while(offset < length) {
+            if(expression[offset] != TJS_W('\\')) {
+                normalized += expression[offset++];
+                continue;
+            }
+
+            const tjs_int slash_begin = offset;
+            while(offset < length && expression[offset] == TJS_W('\\'))
+                ++offset;
+            const tjs_int slash_count = offset - slash_begin;
+            if((slash_count & 1) != 0 && offset < length &&
+               expression[offset] == TJS_W('x')) {
+                const tjs_int digit_begin = offset + 1;
+                tjs_int digit_count = 0;
+                while(digit_begin + digit_count < length && digit_count < 4 &&
+                      TJSIsRegExpHexDigit(expression[digit_begin + digit_count]))
+                    ++digit_count;
+                const tjs_int converted_digits =
+                    digit_count == 4 ? 4 : (digit_count >= 2 ? 2 : 0);
+                if(converted_digits != 0) {
+                    for(tjs_int i = 1; i < slash_count; ++i)
+                        normalized += TJS_W('\\');
+                    normalized += TJS_W('\\');
+                    normalized += TJS_W('u');
+                    if(converted_digits == 2) {
+                        normalized += TJS_W('0');
+                        normalized += TJS_W('0');
+                    }
+                    for(tjs_int i = 0; i < converted_digits; ++i)
+                        normalized += expression[digit_begin + i];
+                    offset = digit_begin + converted_digits;
+                    continue;
+                }
+            }
+
+            for(tjs_int i = 0; i < slash_count; ++i)
+                normalized += TJS_W('\\');
+        }
+        return normalized;
+    }
